# Copy this file to .env and fill in your values.
# Never commit the .env file.

# Target environment URL
TEST_URL=

# Org Admin credentials
ORG_ADMIN_EMAIL=
ORG_ADMIN_PASSWORD=

# Facility Admin credentials
FACILITY_ADMIN_EMAIL=
FACILITY_ADMIN_PASSWORD=

# Department Admin credentials
DEPARTMENT_ADMIN_EMAIL=
DEPARTMENT_ADMIN_PASSWORD=

# Support Team Member credentials
STM_EMAIL=
STM_PASSWORD=

# Support Team Member 2 credentials
STM2_EMAIL=
STM2_PASSWORD=

# Ulink credentials
ULINK_EMAIL=
ULINK_PASSWORD=

# OTP for login (set dynamically in CI/CD)
TEST_OTP=

# Browser to use for tests (chrome, firefox, edge)
TEST_BROWSER=chrome

# Test user identifier
TEST_USER=

# Invalid credentials used in negative login tests
INVALID_TEST_EMAIL=invalid_user@example.com
INVALID_TEST_PASSWORD=wrong_password
